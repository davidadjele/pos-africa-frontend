# Backend vers lequel Vite (npm run dev, npm run preview) relaie les appels /api.
# Non exposé au navigateur (pas de préfixe VITE_). En production : réécriture de vercel.json.
URL_BACKEND=http://localhost:8080

# Adresse publique de l'application, reprise dans les liens et QR codes des reçus. Vide en développement :
# l'adresse de la page sert alors. En production (variable Vercel), par exemple https://app.tonti.africa
VITE_ADRESSE_PUBLIQUE=
